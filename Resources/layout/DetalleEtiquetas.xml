<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="*"
    android:orientation="vertical"
    android:layout_marginTop="80dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />
        <TextView
            android:textColor="#000000"
            android:text="ORDEN:"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ordenve"
            android:gravity="right"
            android:singleLine="true"
            android:paddingRight="5dp"/>
        <TextView
            android:textColor="#000000"
            android:text="TOTAL DE CAJAS:"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/totalcajasleidas"
            android:gravity="right"
            android:singleLine="true"
            android:paddingRight="5dp"/>
        <TextView
            android:textColor="#000000"
            android:text="LECTURAS REALIZADAS: SECCION - PRODUCTO NOMBRE"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"/>
        <TextView
            android:textColor="#000000"
            android:text="RECIBO | CAJAS | TARIMA | PLANTA-CAMPO"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"/>
        <Button
            android:layout_margin="7dp"
            android:text="Quitar Linea"
            android:textColor="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/buttoncancelarenabled"
            android:id="@+id/QuitarLinea"
            android:layout_marginTop="0.0dp"
            android:autoSizeTextType="uniform"
            android:elevation="3dp"/>
    </LinearLayout>
    <GridView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:horizontalSpacing="10dp"
        android:verticalSpacing="10dp"
        android:stretchMode="columnWidth"
        android:numColumns="1"
        android:minWidth="25dp"
        android:minHeight="25dp"
        android:layout_weight="1"
        android:smoothScrollbar="true"
        android:id="@+id/gvleido"
        android:listSelector="@drawable/layerdraw"
        android:drawSelectorOnTop="false"
        android:columnWidth="150dp"
        android:paddingTop="5dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"/>
</LinearLayout>