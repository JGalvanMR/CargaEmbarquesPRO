<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="0dp"
	android:gravity="center"
	android:background="#ffffff"
	android:layout_marginTop="80dp">
	<include
		android:id="@+id/toolbar"
		layout="@layout/toolbar" />
	<LinearLayout
		android:background="#FFD989"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<!-- TextView y EditText en un LinearLayout horizontal -->
		<LinearLayout
			android:layout_width="1dp"
			android:layout_height="wrap_content"
			android:layout_weight="0.5"
			android:orientation="vertical"
			android:layout_gravity="center"
			android:gravity="center">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="FOLIO:"
				android:textColor="#960000"/>

			<EditText
				android:id="@+id/pedingres"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="number"/>
		</LinearLayout>
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical"
			android:layout_gravity="center"
			android:gravity="center">
			<!-- Spinner -->
			<Spinner
				android:id="@+id/cmbpedido"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColor="#000000"
				android:textAlignment="center"/>
		</LinearLayout>


		<!-- Segundo LinearLayout vertical -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical"
			android:layout_gravity="center"
			android:gravity="center">

			<!-- LinearLayout horizontal para PESO -->
			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="PESO: "
					android:textColor="#960000"
                        />

				<TextView
					android:id="@+id/pesoactual"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="10.5 KG"
					android:textColor="#001FFF"/>
			</LinearLayout>

			<!-- LinearLayout horizontal para FECHA -->
			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="FECHA: "
					android:textColor="#960000"
                        />

				<TextView
					android:id="@+id/fechaactual"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="18/11/2020"
					android:textColor="#001FFF"/>
			</LinearLayout>
		</LinearLayout>

		<!-- Tercer LinearLayout vertical -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="0.7"
			android:layout_gravity="center"
			android:gravity="center">

			<!-- TextView y su valor para Hora Inicial -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Hora Inicial:"
				android:textColor="#960000"
                    />

			<TextView
				android:id="@+id/iniciocarga"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="18:33"
				android:textColor="#001FFF"
                    />
		</LinearLayout>
	</LinearLayout>

	<LinearLayout
		android:background="#FFF055"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<!-- Primer LinearLayout vertical -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="LUGAR:"
				android:textColor="#960000"/>

			<TextView
				android:id="@+id/NalExp"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="NAL"
				android:textColor="#001FFF"
                    />
		</LinearLayout>

		<!-- Segundo LinearLayout vertical -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="CAJA:"
				android:textColor="#960000"
                    />

			<TextView
				android:id="@+id/NumTrailer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="No. Trailer"
				android:textColor="#001FFF"
                    />
		</LinearLayout>

		<!-- Tercer LinearLayout vertical -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="ANDEN:  "
				android:textColor="#960000"
                    />

			<TextView
				android:id="@+id/Andencapturado"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="18"
				android:textColor="#001FFF"
                    />
		</LinearLayout>

		<!-- Cuarto LinearLayout vertical -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_gravity="center"
			android:gravity="center">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Hora Final: "
				android:textColor="#960000"
                    />

			<TextView
				android:id="@+id/fincarga"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="18:33"
				android:textColor="#001FFF"
                    />
		</LinearLayout>
	</LinearLayout>

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#ffffff"
		android:layout_span="4">
		<TextView
			android:textColor="#000000"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="CLAVE PRODUCTO: "
			android:paddingLeft="5dp"/>
		<EditText
			android:inputType="text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:editable="false"
			android:textIsSelectable="false"
			android:id="@+id/codigoProducto"/>
		<TextView
			android:textColor="#000000"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="CONFIRMACION ETIQUETA BLANCA: "
			android:paddingLeft="5dp"/>
		<EditText
			android:inputType="text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:editable="false"
			android:textIsSelectable="false"
			android:id="@+id/codigoconfirmProducto" />
	</LinearLayout>

	<LinearLayout
		android:background="#7CE82C"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="TEMP:"
			android:textAlignment="center"
			android:textColor="#960000"
                />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="TIPO TARIMA: "
			android:textAlignment="center"
			android:textColor="#960000"
                />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="POSICION:"
			android:textAlignment="center"
			android:textColor="#960000"
                />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="CAJAS: "
			android:textAlignment="center"
			android:textColor="#960000"
                />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<!-- Primer EditText -->
		<EditText
			android:id="@+id/Temp"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textAlignment="center"
			android:inputType="number"/>

		<!-- Contenedor del Spinner -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical"
			android:gravity="center">

			<!-- Spinner -->
			<Spinner
				android:id="@+id/TipoTar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAlignment="center"
                    />
		</LinearLayout>

		<!-- Segundo EditText -->
		<EditText
			android:id="@+id/txtpos"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textAlignment="center"
			android:inputType="number"/>

		<!-- Tercer EditText -->
		<EditText
			android:id="@+id/cancaj"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textAlignment="center"
			android:inputType="number"/>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentBottom="true"
		android:gravity="center"
		android:orientation="horizontal"
		android:layout_gravity="center_horizontal"
		android:padding="10dp">
		<Button
			android:layout_margin="7dp"
			android:layout_weight="1"
			android:elevation="2dp"
			android:background="@drawable/buttoncargarenabled"
			android:text="INICIAR CARGA"
			android:layout_width="match_parent"
			android:textColor="#ffffff"
			android:layout_height="wrap_content"
			android:id="@+id/IniciarCarga"
			android:visibility="visible"
			android:autoSizeTextType="uniform"/>
		<Button
			android:layout_margin="7dp"
			android:layout_weight="1"
			android:elevation="2dp"
			android:text="Foto"
			android:textColor="#ffffff"
			android:background="@drawable/buttonfotoenabled"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:id="@+id/Fotoevent"
			android:visibility="visible"
			android:autoSizeTextType="uniform"/>
	</LinearLayout>

	<TextView
		android:textColor="#000000"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="FechaTrailer:"
		android:id="@+id/LblFT"
		android:visibility="invisible"
            />

	<FrameLayout
		android:id="@+id/contenedorFragment"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

</LinearLayout>