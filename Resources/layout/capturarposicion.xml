<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbarAlwaysDrawVerticalTrack="true"
    android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
    android:scrollbarThumbHorizontal="@drawable/scrollbar_vertical_thumb"
    android:layout_centerInParent="true"
    android:layout_weight="1">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp"
        android:gravity="center"
        android:background="#ffffff"
        android:layout_marginTop="80dp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_height="263.5dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_width="match_parent"
                android:minWidth="25dp"
                android:minHeight="25dp"
                android:id="@+id/fotopos" />
            <TextView
                android:textColor="#000000"
                android:text="Orden de Venta:"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtordenventa"
                android:paddingLeft="5dp"/>
            <TextView
                
                android:textColor="#000000"
                android:text="Posicion:"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtposicion"
                android:paddingLeft="5dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:padding="10dp">
                <Button
                    android:elevation="2dp"
                    android:layout_margin="7dp"
                    android:text="Tomar Foto"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/TomarFoto"
                    android:background="@drawable/buttonfotoenabled"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"/>
                <Button
                    android:elevation="2dp"
                    android:text="Guardar Foto"
                    android:layout_margin="7dp"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/GuardarFoto"
                    android:background="@drawable/buttoncargarenabled"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>