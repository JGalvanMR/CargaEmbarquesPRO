<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
    android:scrollbarThumbHorizontal="@drawable/scrollbar_vertical_thumb"
    android:scrollbarAlwaysDrawVerticalTrack="true"
    android:layout_centerInParent="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_login_ui"
        android:backgroundTint="#ffffff"
        android:elevation="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginStart="1dp"
        android:layout_marginLeft="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginRight="1dp">

        <TextView
            android:textColor="#000000"
            android:text="INFORMACION DE CARGA ADICIONAL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="25px"
            android:minHeight="25px"
            android:textAlignment="center"
            android:layout_alignParentTop="true"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold"
            android:padding="7dp"/>

        <TextView
            android:text="Clave Anden:"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"/>
        <EditText
            android:id="@+id/idanden"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="14"
            android:enabled="false"
            android:textColor="#000000"
            android:editable="false"/>

        <TextView
            android:textColor="#000000"
            android:text="Clave Adicional:"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/idadicional"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:padding="10dp">
            <Button
                android:layout_margin="7dp"
                android:id="@+id/CargarAdicional"
                android:text="CARGAR"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/buttoncargarenabled"
                android:textColor="#ffffff"
                android:elevation="2dp"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"/>
            <Button
                android:layout_margin="7dp"
                android:id="@+id/CancelarAdicional"
                android:text="CANCELAR"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/buttoncancelarenabled"
                android:textColor="#ffffff"
                android:elevation="2dp"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>